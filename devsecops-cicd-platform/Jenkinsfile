pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(
            name: 'TEST_ROLLBACK',
            defaultValue: false,
            description: 'Deliberately deploy a missing image to verify automatic rollback'
        )
    }

    environment {
        JAVA_HOME = "/opt/homebrew/opt/openjdk@21"
        PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"
        IMAGE_NAME = "zephyrworks-turbine-api"
        AWS_REGION = "eu-west-2"
        AWS_PROFILE = "zephyrworks-devsecops"
        NEXUS_URL = "http://127.0.0.1:8081"
        NEXUS_REPOSITORY = "zephyrworks-builds"
    }

    stages {
        stage('Verify toolchain') {
            steps {
                sh 'python3 --version'
                sh 'git --version'
                sh 'aws --version'
                sh 'aws sts get-caller-identity'
                sh 'trivy --version'
            }
        }

        stage('Install dependencies') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh 'python3 -m venv --clear .venv'
                    sh '.venv/bin/python -m pip install --requirement requirements-dev.txt'
                }
            }
        }

        stage('Dependency audit') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh '.venv/bin/python -m pip_audit --requirement requirements.txt'
                }
            }
        }

        stage('Infrastructure security scan') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh '''
                        trivy config \
                          --severity HIGH,CRITICAL \
                          --format json \
                          --output trivy-terraform-report.json \
                          --exit-code 1 \
                          infrastructure

                        trivy config \
                          --severity HIGH,CRITICAL \
                          --format json \
                          --output trivy-kubernetes-report.json \
                          --exit-code 1 \
                          kubernetes
                    '''
                }
            }
        }

        stage('Lint') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh '.venv/bin/python -m ruff check app tests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh '.venv/bin/python -m pytest --junitxml=test-results.xml'
                }
            }
        }

        stage('SonarQube analysis') {
            steps {
                dir('devsecops-cicd-platform') {
                    script {
                        def scannerHome = tool 'SonarQube Scanner'

                        withSonarQubeEnv('SonarQube Local') {
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build container') {
            steps {
                dir('devsecops-cicd-platform') {
                   sh 'docker build --pull --no-cache --tag ${IMAGE_NAME}:${BUILD_NUMBER} .'
                   sh 'docker run --rm ${IMAGE_NAME}:${BUILD_NUMBER} id'
                }
            }
        }

        stage('Container vulnerability scan') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh '''
                        trivy image \
                          --scanners vuln \
                          --sbom-sources "" \
                          --ignore-unfixed \
                          --severity HIGH,CRITICAL \
                          --format json \
                          --output trivy-report.json \
                          --exit-code 1 \
                          ${IMAGE_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Push image to ECR') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh '''
                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                          --query Account \
                          --output text)

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        IMAGE_TAG="$(git rev-parse --short=7 HEAD)-${BUILD_NUMBER}"
                        ECR_IMAGE="${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

                        aws ecr get-login-password \
                         --region "${AWS_REGION}" \
                        | docker login \
                         --username AWS \
                         --password-stdin "${ECR_REGISTRY}"

                        docker tag \
                          "${IMAGE_NAME}:${BUILD_NUMBER}" \
                          "${ECR_IMAGE}"

                        docker push "${ECR_IMAGE}"

                        echo "Published image: ${ECR_IMAGE}"
                    '''
                }
            }
        }

        stage('Publish build artefacts to Nexus') {
            steps {
                dir('devsecops-cicd-platform') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'nexus-credentials',
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASSWORD'
                        )
                    ]) {
                        sh '''
                            AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                              --query Account \
                              --output text)

                            GIT_COMMIT_FULL=$(git rev-parse HEAD)
                            GIT_COMMIT_SHORT=$(git rev-parse --short=7 HEAD)
                            IMAGE_TAG="${GIT_COMMIT_SHORT}-${BUILD_NUMBER}"
                            ECR_IMAGE="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_NAME}:${IMAGE_TAG}"
                            BUNDLE_NAME="${IMAGE_NAME}-${IMAGE_TAG}.tar.gz"

                            printf '{\\n  "build_number": "%s",\\n  "git_commit": "%s",\\n  "image": "%s",\\n  "jenkins_url": "%s"\\n}\\n' \
                              "${BUILD_NUMBER}" \
                              "${GIT_COMMIT_FULL}" \
                              "${ECR_IMAGE}" \
                              "${BUILD_URL}" \
                              > build-metadata.json

                            tar -czf "${BUNDLE_NAME}" \
                              build-metadata.json \
                              coverage.xml \
                              test-results.xml \
                              trivy-report.json \
                              trivy-terraform-report.json \
                              trivy-kubernetes-report.json

                            curl \
                              --fail-with-body \
                              --silent \
                              --show-error \
                              --user "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                              --upload-file "${BUNDLE_NAME}" \
                              "${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/turbine-api/${GIT_COMMIT_SHORT}/${BUILD_NUMBER}/${BUNDLE_NAME}"

                            echo "Published Nexus artefact: ${BUNDLE_NAME}"
                        '''
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('devsecops-cicd-platform') {
                    sh '''
                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                          --query Account \
                          --output text)

                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        IMAGE_TAG="$(git rev-parse --short=7 HEAD)-${BUILD_NUMBER}"
                        ECR_IMAGE="${ECR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

                        PREVIOUS_IMAGE=$(kubectl get deployment turbine-api \
                          --namespace zephyrworks \
                          --output jsonpath='{.spec.template.spec.containers[0].image}')

                        DEPLOY_IMAGE="${ECR_IMAGE}"

                        if [ "${TEST_ROLLBACK}" = "true" ]
                        then
                            DEPLOY_IMAGE="${ECR_REGISTRY}/${IMAGE_NAME}:rollback-test-missing-${BUILD_NUMBER}"
                            echo "Rollback test enabled; attempting deployment with: ${DEPLOY_IMAGE}"
                        fi

                        kubectl annotate deployment/turbine-api \
                          --namespace zephyrworks \
                          kubernetes.io/change-cause="Deploy ${IMAGE_TAG} from Jenkins build ${BUILD_NUMBER}" \
                          --overwrite

                        kubectl set image deployment/turbine-api \
                          turbine-api="${DEPLOY_IMAGE}" \
                          --namespace zephyrworks

                        if ! kubectl rollout status deployment/turbine-api \
                          --namespace zephyrworks \
                          --timeout=120s
                        then
                            echo "Deployment failed; rolling back to the previous revision"

                            kubectl set image deployment/turbine-api \
                              turbine-api="${PREVIOUS_IMAGE}" \
                              --namespace zephyrworks

                            kubectl rollout status deployment/turbine-api \
                              --namespace zephyrworks \
                              --timeout=120s

                            ROLLED_BACK_IMAGE=$(kubectl get deployment turbine-api \
                              --namespace zephyrworks \
                              --output jsonpath='{.spec.template.spec.containers[0].image}')

                            test "${ROLLED_BACK_IMAGE}" = "${PREVIOUS_IMAGE}"
                            echo "Rollback successful: ${ROLLED_BACK_IMAGE}"

                            exit 1
                        fi

                        DEPLOYED_IMAGE=$(kubectl get deployment turbine-api \
                          --namespace zephyrworks \
                          --output jsonpath='{.spec.template.spec.containers[0].image}')

                        test "${DEPLOYED_IMAGE}" = "${ECR_IMAGE}"
                        echo "Successfully deployed: ${DEPLOYED_IMAGE}"
                    '''
                }
            }
        }
    }



    post {
        always {
            junit allowEmptyResults: true,
                testResults: 'devsecops-cicd-platform/test-results.xml'
            archiveArtifacts allowEmptyArchive: true,
                artifacts: 'devsecops-cicd-platform/coverage.xml'
            archiveArtifacts allowEmptyArchive: true,
                artifacts: 'devsecops-cicd-platform/trivy-report.json'
            archiveArtifacts allowEmptyArchive: true,
                artifacts: 'devsecops-cicd-platform/trivy-*-report.json'
            archiveArtifacts allowEmptyArchive: true,
                artifacts: 'devsecops-cicd-platform/*.tar.gz'
        }
    }
}
